{
  "name": "the-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
